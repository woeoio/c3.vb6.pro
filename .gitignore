# ============================
# vb6c3 项目 .gitignore
# ============================

# ---------- 构建产物 ----------
.build/
build/
out/
output/
cmake-build-*/
tmp

# ---------- 发布产物 (scripts\release.bat 打包输出) ----------
dist/

# ---------- GitCode 发布令牌 (仅本机) ----------
scripts/.gitcode_token

# ---------- CMake 生成物 ----------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.ninja
*.ninja_deps
*.ninja_log
compile_commands.json
CTestTestfile.cmake
deps/

# ---------- 编译产物 ----------
*.obj
*.o
*.a
*.lib
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.res
*.manifest
*.rc（生成的）
*.so
*.dylib
*.tlh
*.tli

# ---------- CI 关注脚本(仅本机) ----------
scripts/watch-gh-actions.ps1

# ---------- 测试运行产物 ----------
# tests/*.bas 用 Open ... For Output 写相对路径文件 (scores.txt / test_output.txt /
# test_*.dat / m6_test.txt 等)。run_tests.ps1 运行测试时已把工作目录设为 output/,
# 这些产物随之落入 output/ (第 9 行已整体忽略), 故这里不再逐个列举文件名 ——
# 否则每新增一个写文件的测试, 根目录就多一个需要补丁的垃圾文件。

# ---------- IDE / 编辑器 ----------
.vs/
.vscode/
*.user
*.suo
*.sln
*.vcxproj*
.idea/
*.swp
*.swo
*~

# ---------- 临时文件 ----------
.temp/
*.tmp
*.bak
*.log

# ---------- OS 产物 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- Python（如果用脚本辅助）----------
__pycache__/
*.pyc

# ---------- Node（如果做 VS Code 扩展）----------
node_modules/

# ---------- 参考项目源码（只保留 URL 书签）----------
reference/freebasic/fbc/
reference/AvaloniaVisualBasic6/AvaloniaVisualBasic6/
reference/*
!reference/*.url


.playwright-mcp

publish/msvc

_bak

# ---------- 归档目录 (archive/) ----------
# archive/ 存放已停止维护但需保留备查的代码 (如 VBMANLIB 的 vendored 副本)。
# 注意: archive/vbman 仍在版本控制内, 不能再整体忽略 —— 之前 .gitignore 里的
#       "vbman/" 不带前导斜杠, 会匹配任意层级的 vbman 目录, 导致 349 个
#       已跟踪文件同时处于 ignored 状态, 此后新增文件无法入库。已删除该行。
# 归档 = 完整快照, 其中的 dll/exp/res/log/_bak 产物一并保留, 故整体反忽略。
!archive/**

# ---------- 必须入库的构建产物 (反忽略, 勿删) ----------
# RTL 预编译库: CMakeLists.txt 把 src/rtl/lib/*.lib 声明为 c3rtl.rc 的
# OBJECT_DEPENDS (C3.exe 以 RCDATA 嵌入), 缺了 C3.exe 会链接失败。
!src/rtl/lib/*.lib
!src/rtl/lib/x86/*.lib

# ---------- 专项修复小工程 (fix_tool.ps1) ----------
archive/vbman/src/_fix/
archive/vbman/src/FIX_*.vbp
scripts/_fix_run.cmd
scripts/_fix_*.txt
scripts/_fix_*.ps1

# tests 对照回归工作目录 (regress_all.ps1 运行产物)
tests/_vb6ref*/

# ---------- 运行期掉落物 / 一次性分析脚本 (2026-09-22) ----------
# 崩溃转储与探针输出: 每次跑 GUI 用例都会重新生成, 不进版本库
c3_crash.txt
probe.txt
# 链接器 /MAP 产物 (VBFlexGridDemo.map 等)
*.map
# 会话/工具临时目录与临时批处理
.workbuddy/
scripts/_tmp_*.bat
# VB6 工程工作区文件 (IDE 状态, 每人不同)
*.vbw

# 二分定位调试产物 (bisect*.vbp): 不属于门禁用例
**/bisect*.vbp
tests/ctrlstatusbar/run*.out
# 账 #245 的语料发码清单（本机/CI 各产一份，只用于两边对 diff，不入仓）
emit-manifest.txt
