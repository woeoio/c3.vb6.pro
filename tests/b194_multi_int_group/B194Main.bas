Option Explicit

' 账 #305 §11.169 (第一百八十六刀): 整数区多组占位符 —— 数字按组分配。
'
' 真 VB6 读数 (.temp/k186p/P204.bas + P199 L16 + P203 R10 + P200 N14, 逐字抄自 p2xx.txt):
'   G1  0 0        @1234  -> "123 4"      两组 1/1, 右往左各拿自己的容量, 最左组吸收余数
'   G2  0 00       @1234  -> "12 34"
'   G3  00 0       @1234  -> "123 4"
'   G4  0 000      @1234  -> "1 234"
'   G5  000 0      @1234  -> "123 4"
'   G6  00 00      @1234  -> "12 34"
'   G7  #,##0 0    @1234  -> "1,23 4"     千分位是**整串**先插, 再切组 (逗号跟着左块走)
'   G8  0 #,##0    @1234  -> "0 1,234"    左边组拿不到数时按自己的 0/# 补位
'   G9  #0 0       @1234  -> "123 4"
'   G10 0 #0       @1234  -> "12 34"
'   G15 00 00      @12    -> "00 12"      数字不够分
'   G16 0 0        @12    -> "1 2"
'   G17 0 0        @0     -> "0 0"
'   G18 0;0;0      @1234  -> "1234"       分段不是分组 (反向证人)
'   G19 0 / 0      @1234  -> "123 / 4"    (P199 L16)
'   G20 0 A/P 0    @1234  -> "123 A/P 4"  (P203 R10; 上午/下午记号在 0 之后仍只是字面量)
'   G21 0 h, 0 m   @1234  -> "1,23 h 4 m" (P200 N14; 组外那个逗号也是千分位记号, 不打印)
'
' 带小数点的多组 (G11..G14: 0.0 0.0 / 0 0.00 / 0.00 0 / 0.0"x"0.0) 真机不合这几条规律,
' 本刀不做, 记在册。

Public Sub Main()
    Show "G1", Format(1234, "0 0")
    Show "G2", Format(1234, "0 00")
    Show "G3", Format(1234, "00 0")
    Show "G4", Format(1234, "0 000")
    Show "G5", Format(1234, "000 0")
    Show "G6", Format(1234, "00 00")
    Show "G7", Format(1234, "#,##0 0")
    Show "G8", Format(1234, "0 #,##0")
    Show "G9", Format(1234, "#0 0")
    Show "G10", Format(1234, "0 #0")
    Show "G15", Format(12, "00 00")
    Show "G16", Format(12, "0 0")
    Show "G17", Format(0, "0 0")
    Show "G18", Format(1234, "0;0;0")
    Show "G19", Format(1234, "0 / 0")
    Show "G20", Format(1234, "0 A/P 0")
    Show "G21", Format(1234, "0 h, 0 m")

    Debug.Print "B194-DONE"
End Sub

Private Sub Show(ByVal tag As String, ByVal s As String)
    Debug.Print tag & "=[" & s & "]"
End Sub
