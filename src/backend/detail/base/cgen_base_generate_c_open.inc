// cgen_base_generate_c_open.inc - generate 函数体片段：.c 源文件头与类模块结构体定义
// 由 src/backend/cgen_base.cpp 拆出（2026-09-17），在函数体内被 #include，非独立编译单元。
// 内容 = 原文件第 385~497 行，逐行未改。

    // 生成 .c 源文件头
    c_.emitLine("// Generated by vb6c3 (C3.exe) from " + module.filename);
    c_.emitLine("#include \"" + baseName_ + ".h\"");
    // P13.23: External COM WithEvents need vb6com.h for vb6_CreateEventSink/ComAdvise/ComUnadvise
    // <vbeclipse> 改为**无条件** include —— 上面 P6.6.3 / rev18 给 vb6comserver.h 定过
    // 的教训同样适用：`vb6_ComCall` / `vb6_ComGetStringProp` / `vb6_ComPackInt` /
    // `vb6_ComSetObjectProp` 这些后期绑定 helper 的**任何**一次 emit 都要求原型可见。
    // 之前只在"有 WithEvents"/"有 ComLib" 时 include, 剩下的模块里 VB `Set obj = ...`
    // 或 `Call X.Method(args)` 一旦掉进 vb6_ComCall(...) 形态, 就没有原型 →
    // cl 19.29 只 C4013 隐式声明 (返回 int 截断指针, 埋 x64 崩雷);
    // cl 19.51 (GA runner) 直接把隐式声明 + 后续 argcount 判成
    // **C2172 / C2197 / C2198 / C2224** (VTableHandle.c 458/461/469/475/481/... 一次
    // 爆 30+ 条)。头是纯声明 (`#pragma once` 双 include 无害), EXE/DLL 的 .c 无副作用。
    c_.emitLine("#include \"vb6com.h\"");
    // Fix 160: ComLib= 免注册组件表 — 入口点里烘焙 static Vb6ComLib 表并调
    // vb6_ComLibRegister, 需 vb6com.h 提供 Vb6ComLib 类型. 表空则不发 (零回归).
    // DLL 工程不发: ActiveX DLL 的入口点是 dll_entry.c, 此处不烘焙表, 加了也只是死头.
    if (!isDll_ && !isClassModule_ && comLibRefs_ && !comLibRefs_->empty()) {
        c_.emitLine("#include \"vb6com.h\"");
    }
    // P6.6.3: ActiveX DLL 类模块需要 vb6comserver.h
    //   - 有事件: vb6_FireEvent
    //   - Fix 099: 有显式 Public 字段: vb6_ComObject_FromInstance / vb6_FindCoClassDesc
    //     (字段读写访问器生成在类模块自身的 .c 里, 见 cgen_com.cpp emitClassFieldAccessors).
    //     原先只在"有事件"时才 include, 会让无事件的 DLL 类模块拿到隐式声明 ——
    //     C 下隐式声明的返回值按 int 截断, 指针会被砍成 32 位 (x64 必崩);
    //     改为 DLL 类模块一律 include.
    // ExeComBridge 01: 类模块一律 include vb6comserver.h (原先仅 DLL).
    //   EXE 侧工程类实例也要能被包装成 IDispatch: emitClassFieldAccessors 生成的
    //   字段访问器引用 vb6_ComObject_FromInstance / vb6_FindCoClassDesc /
    //   vb6_ComObject_GetInstance (声明在此头), 缺头会 C4013 隐式声明截断指针
    //   (Fix 099 同款教训). 纯头文件无导出修饰, EXE .c include 无副作用.
    //
    // Fix <vbeclipse> rev18: 改为**无条件** include。
    // 上面那条"类模块一律 include"漏了**非类模块 (.bas/.frm)** —— 而它们同样会发出
    // 引用此头里声明的函数的代码: 把工程类实例装箱成 Variant
    // (`vb6_ComObject_FromInstance` / `vb6_FindCoClassDesc`) 与从 Variant 剥回实例
    // (`vb6_ComObject_GetInstance`)。缺头 = 该 TU 里没有原型 = C 的隐式声明按 int 截断
    // 返回的**指针** —— x86 侥幸(指针 4 字节), **x64 必崩**。
    // 实证 tests/ve_list (x86 全绿 / x64 0xC0000005): 崩在
    // `vb6_ComObject_GetInstance+0x2E` 读 `obj->vtable`, av read target=0x661751e0
    // —— 正是被砍成 32 位的包装器地址; 调用链来自 `.bas` 里的 `Set back = L.Item("Props")`。
    // 头是纯声明 (无导出修饰), EXE/DLL 的 .c include 均无副作用。
    c_.emitLine("#include \"vb6comserver.h\"");
    // P8.7 + Fix 010r-12: 标准模块之间的#include放在.c文件，避免.h循环依赖
    // 类模块引用标准模块 → .h (见上方); 标准模块引用标准模块 → .c
    // opt4: --trim-includes 时按符号表实际引用裁剪, 未引用模块仅补 init 前向声明
    {
        for (const auto& extMod : externalModules) {
            auto* extSym = symTab_.lookup(extMod);
            bool extIsClass = extSym && extSym->kind == SymbolKind::Class;
            if (!extIsClass && !isClassModule_) {
                if (!trimIncludes_ || trimModules_.count(Symbol::toLower(extMod))) {
                    c_.emitLine("#include \"" + extMod + ".h\"");
                } else {
                    // opt4: 未实际引用 → 只补初始化函数前向声明 (Fix 080 仍需调用)
                    c_.emitLine("void vb6_mod_" + cIdent(extMod) + "_init(void);  /* opt4: trimmed include */");
                }
            }
        }
    }
    c_.emitBlank();

    // === 类模块: 生成结构体定义 ===
    if (isClassModule_) {
        std::string clsStruct = "vb6_cls_" + cIdent(moduleName_);  // Fix 013: 用 moduleName_ (VB_Name)
        h_.emitLine("// Class module: " + module.moduleName);

        // P6.5: 前向声明event sink结构体 (在类结构体定义之前)
        bool hasEvents = false;
        for (auto& decl : module.declarations) {
            if (decl->kind == ASTNodeKind::EventDecl) { hasEvents = true; break; }
        }
        if (hasEvents) {
            std::string sinkName = "vb6_events_" + cIdent(moduleName_);  // Fix 013: 用 moduleName_
            h_.emitLine("struct " + sinkName + ";  /* P6.5: forward decl */");
        }

        h_.emitLine("typedef struct " + clsStruct + " {");
    // ExeComBridge 01: __comObj 无条件生成 (原先仅 DLL 工程).
    //   vb6comserver_obj.c 的包装复用规则前置条件: 实例结构体首字段必须是 __comObj.
    //   EXE 侧工程类实例也要能被包装成 IDispatch (阶段 3 在打包点接入).
    //   纯 EXE 下无人写读该字段, _New() 置 NULL, 现有程序行为零变化.
    h_.emitLine("    void* __comObj;  /* P6.6.3: back-ptr to COM wrapper (vb6_ComObject*) */");
    // tB Interface 契约 (B04): 每个新式接口一个槽指针字段; **必须排在 __comObj 之后**
    // (vb6comserver_obj.c 按裸偏移 0 读写 __comObj, 见 ai/022 D19 的硬修正)
    emitIfaceClassFields(module);
    // 类虚表 (tB B08d): __cvtbl 排在 __comObj/__iv_ 之后、祖先字段之前 —— 整条继承链上偏移一致
    // (前缀布局的硬要求, 见 ai/022 D32②)。无虚槽的类不加这个字段。
    emitClassVirtField(module);

        // 收集模块级变量作为结构体字段 (tB B07b: 继承字段在前, 派生前缀必须与祖先一致)
        bool hasFields = false;
        for (VariableDecl* var_p : structFieldDecls(module)) {
            if (var_p) {
                hasFields = true;
                auto& var = *var_p;
                std::string cType = mapTypeRef(var.asType.get());
                if (var.isDynamicArray || !var.dimensions.empty()) {
                    // 数组: 使用vb6_SafeArray1D*/vb6_SafeArrayND* (NOT SAFEARRAY*)
                    Vb6Type elemType = resolveArrayElemType(var.asType.get());
                    int dimCount = (int)var.dimensions.size();
                    std::string arrType = (dimCount > 1) ? "vb6_SafeArrayND*" : "vb6_SafeArray1D*";
                    h_.emitLine("    " + arrType + " " + cIdent(var.name) + "; /* " +
                                TypeSystem::typeToString(elemType) + " array */");
                } else if (var.isNew) {
                    // Dim x As New ClassName → 指针字段
                    h_.emitLine("    void* " + cIdent(var.name) + "; /* As New " +
                                (var.asType ? static_cast<SimpleTypeRef*>(var.asType.get())->name : "Object") + " */");
                } else {
                    h_.emitLine("    " + cType + " " + cIdent(var.name) + ";");
                }
            }
        }
        // C不允许空结构体 → 接口类无数据成员时添加占位字段
        if (!hasFields) {
            h_.emitLine("    int _placeholder;  /* interface class: no data members */");
        }
        // P6.5: 如果类有事件声明，添加事件接收器指针字段
        if (hasEvents) {
            std::string sinkName = "vb6_events_" + cIdent(moduleName_);  // Fix 013: 用 moduleName_
            h_.emitLine("    struct " + sinkName + "* events;  /* P6.5: event sink */");
        }
        h_.emitLine("} " + clsStruct + ";");
        h_.emitBlank();

        // 类工厂函数声明
        h_.emitLine(clsStruct + "* " + clsStruct + "_New(void);");
        // ai/084c: 带参构造工厂 (Class_Initialize 带形参时) — `New Cls(args)` 的
        // 调用点通常在别的模块, 原型必须跨模块可见 (同 _New 本身)。
        for (auto& decl : module.declarations) {
            if (decl && decl->kind == ASTNodeKind::SubDecl) {
                auto& sub = static_cast<SubDecl&>(*decl);
                if (sub.name == "Class_Initialize" && !sub.params.empty()) {
                    h_.emitLine(clsStruct + "* " + clsStruct + "_NewParams(" + makeParamList(sub.params) + ");");
                    break;
                }
            }
        }
        h_.emitLine("void " + clsStruct + "_Destroy(" + clsStruct + "* me);");
        // ExeComBridge 03: COM 实参打包函数 (实现在本类 .c, 见 cgen_com.cpp
        // emitClassFactory). 声明必须跨模块可见 —— `New <该类>` 的调用点通常
        // 在别的模块 (VBMAN_DEMO 的 Form1.frm), 缺声明就是隐式 int 截断指针.
        h_.emitLine("void* vb6_ComPack_" + cIdent(moduleName_) + "(void* instance);");
        // P6.4+: 默认实例 (VB_PredeclaredId=True) 惰性单例访问器, 跨模块可见
        if (!defaultInstanceClassName(moduleName_).empty()) {
            h_.emitLine(clsStruct + "* " + clsStruct + "_Default(void);");
        }
        h_.emitBlank();

        // 类虚表 (tB B08d): 本类视图的表类型 + 表实例声明。发在类结构体之后 —— 槽项的 me 形参
        // 就是刚定义好的 vb6_cls_<X>*, 不需要任何跨模块的类型可见性。
        emitClassVirtType(module);

        // P6.4: 生成接口vtable结构体 + 包装类型 + 全局vtable实例
        if (!module.implements.empty()) {
            emitInterfaceVtable(module);
            emitIfaceImplTables(module);  // tB Interface 契约 (B04): 新式接口另发一套表
        }

        // P6.5: 生成事件接收器表 (事件源类的回调函数指针表)
        if (hasEvents) {
            emitEventSink(module);
        }
    }

